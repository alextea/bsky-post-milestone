# Copy to .env for local development. `npm run watch` loads it with dotenv.
# In production, set these in the host's environment instead.

# Port the app listens on (default 8080)
# PORT=8080

# Public URL of the site, used for link cards and share images.
# Defaults to the request's protocol and host.
# SITE_URL=http://localhost:8080

# The bot account's handle, shown on pages and share images
BOT_HANDLE=

# Umami analytics, only included when both are set
UMAMI_URL=
UMAMI_WEBSITE_ID=

# Screenshot service for link card images (see screenshot.js)
SCREENSHOT_SERVICE_URL=
SCREENSHOT_SERVICE_API_KEY=
SAVE_S3_BUCKET=
SAVE_S3_REGION=
